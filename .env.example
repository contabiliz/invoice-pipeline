# ── Broker ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ── Database (PgBouncer transaction pooling endpoint) ─────────────────────
# Local dev: direct PostgreSQL (no PgBouncer)
DATABASE_URL=postgresql://invoice:invoice@localhost:5432/invoice

# ── Supabase Storage ──────────────────────────────────────────────────────
# Point to your Supabase project or a local storage emulator.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
STORAGE_BUCKET=documents

# ── Gemini (worker-img only) ──────────────────────────────────────────────
# Do NOT set this on xml/pdf worker containers.
GEMINI_API_KEY=
GEMINI_RATE_LIMIT_RPM=60

# ── Worker tuning (set per container at launch) ───────────────────────────
# WORKER_QUEUES=queue.pdf
# WORKER_POOL=prefork
# WORKER_CONCURRENCY=4
